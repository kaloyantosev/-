{
  "functions": {
    "api/send-contract.js": {
      "includeFiles": "assets/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/login",
      "dest": "/login.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/c/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/([^/]+)/([^/]+)",
      "dest": "/index.html"
    },
    {
      "src": "/([^/]+)",
      "dest": "/index.html"
    }
  ]
}
